# --- Required for real AI output ---
# Free key from https://aistudio.google.com/apikey  (separate from a Google AI Pro subscription)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Database ---
# Postgres connection string (Neon / Supabase free tier). If empty, a local PGlite file (.pglite) is used:
# fine for development, but it is wiped on redeploy on free hosts.
DATABASE_URL=

# --- Seed accounts (first start only) ---
ADMIN_EMAIL=admin@duck.test
ADMIN_PASSWORD=
DEMO_PASSWORD=
SEED_DEMO=true

# --- Beta guard rails (free API tier is limited) ---
AI_CONCURRENCY=2
DAILY_RUN_CAP_PER_USER=60

# Local UI testing without a key (refused in production): AI_PROVIDER=stub
AI_PROVIDER=gemini
